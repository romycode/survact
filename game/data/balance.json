    "eat_below": 0.35,
    "warm_below": 0.35,
    "warm_enough": 0.95,
    "cold_loss_per_degree_per_day": 0.0556,
    "heater_warmth_per_second": 0.045,
    "ambient_recovery_per_second": 0.006
  },

  "heater": {
    "radius_tiles": 6,
    "wood_per_degree_per_day": 2.16
  },

  "work": {
