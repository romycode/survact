<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless console runner. No test framework on purpose: zero dependencies, runs anywhere,
       and the perf/soak tests need a plain Release process anyway. Swap to xUnit later if wanted. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Survact.Sim/Survact.Sim.csproj" />
  </ItemGroup>
</Project>
